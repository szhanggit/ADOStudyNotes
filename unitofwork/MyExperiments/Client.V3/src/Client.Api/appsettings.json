{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Error"
      }
    }
  },
  "SqlCommand": {
    "CommandTimeout": 3600
  },
  "ShardConfiguration": {
    "ShardMapName": "TenantList"
  },
  "DirectoryConfig": {
    "MainPath": "client-library"
  },
  "ApplicationInsights": {
    "RoleName": "Client",
    "AppVersion": "1.0.0.0"
  },
  "SwaggerConfiguration": {
    "ExcludeTenantHeaders": [
      "HealthCheck"
    ]
  },
  "ServiceUrlConfiguration": {
    "ServiceCreditUrl": "http://credit-api-prod.staging.svc.cluster.local:9022/"
  },
  "Cache": {
    "ProgramCollection": {
      "Uri": "http://tenant-api-svc.prod.svc.cluster.local:9000",
      "ExpirationSeconds": 86400
    },
    "TenantConfig": {
      "Uri": "http://tenant-api-svc.prod.svc.cluster.local:9000",
      "ExpirationSeconds": 86400
    }
  },
  "AllowedHosts": "*"
}
