<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RepositoryPatternHybrid</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\MediaController.cs" />
    <Compile Remove="Controllers\MediaUsingSqlController.cs" />
  </ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
	</ItemGroup>




  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.50.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Service\Protos\order.proto" GrpcServices="Client" Link="Protos\order.proto" />
		<Protobuf Include="..\Service\Protos\order_detail.proto" GrpcServices="Client" Link="Protos\order_detail.proto" />
		<Protobuf Include="..\Service\Protos\product.proto" GrpcServices="Client" Link="Protos\product.proto" />
		<Protobuf Include="..\Service\Protos\decimal_value.proto" GrpcServices="Client" Link="Protos\decimal_value.proto" />

	</ItemGroup>


</Project>
